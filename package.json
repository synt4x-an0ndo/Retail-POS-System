{
  "name": "therawbros-pos",
  "productName": "The Raw Bros POS",
  "version": "1.2.1",
  "description": "Garments Retail POS - The Raw Bros Retail POS Solutions",
  "author": "The Raw Bros",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win --x64",
    "seed:demo": "vite build --config scripts/vite.seed.config.mts --logLevel warn && node out/seed/seed-demo.cjs",
    "test:core": "vite build --config scripts/vite.test.config.mts --logLevel warn && node out/test/smoke-test.cjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "bwip-js": "4.11.4",
    "electron-updater": "6.8.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
